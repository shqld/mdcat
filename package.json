{
  "name": "@shqld/mdcat",
  "version": "0.1.0",
  "description": "Render Markdown and Markdown diffs in the terminal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shqld/mdcat.git"
  },
  "keywords": [
    "markdown",
    "diff",
    "git",
    "terminal",
    "cli"
  ],
  "type": "module",
  "bin": {
    "mdcat": "./dist/mdcat.js",
    "mdgit": "./dist/mdgit.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/mdcat.js dist/mdgit.js",
    "check": "bun run typecheck && bun run build && bun test",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=26.4.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "diff": "^9.0.0",
    "marked": "^17.0.1",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
